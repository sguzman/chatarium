{
  "manifest_version": 3,
  "name": "Chatarium Edge Bridge",
  "version": "0.4.8",
  "description": "Credential-contained bridge between Chatarium Desktop and an authenticated ChatGPT tab.",
  "permissions": [
    "debugger",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:43117/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Chatarium Edge Bridge"
  }
}
